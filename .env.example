# --- Required ---
# Database (https://upstash.com): REST URL and REST token from your Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A long random secret (e.g. `openssl rand -hex 24`). Used once, on /admin/setup, to create or reset the admin account.
ADMIN_KEY=

# Your public site address, no trailing slash. Used in emails, payment callbacks and the sitemap.
SITE_URL=https://yourdomain.com

# --- Quote engine: the defaults are PLACEHOLDERS. Set real values before charging anyone. ---
SERVICE_FEE_USD=1.5
SHIPPING_USD_PER_LB=8
US_SALES_TAX_RATE=0.07
DUTY_RATE=0.2
PAYMENT_FEE_RATE=0.02
NGN_PER_USD=1550
FX_BUFFER_RATE=0.03

# --- Taking payment ---
# Until Paystack is set up, customers see these bank-transfer details on a quoted order.
# Use \n for line breaks, e.g. "GTBank\nAccount name: Your Business\nAccount number: 0123456789"
PAYMENT_INSTRUCTIONS=

# Online payment (https://paystack.com). Webhook URL to add in Paystack: {SITE_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# --- Email (optional until you set it up) ---
# https://resend.com. Without a key, emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=Shopbrow <hello@yourdomain.com>
# Where new-request alerts go
ADMIN_EMAIL=

# --- Contact details shown in the footer and legal pages (optional) ---
SUPPORT_EMAIL=
# Digits with country code, e.g. 2348012345678
WHATSAPP_NUMBER=
