UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required to view the waitlist and requests admin pages
ADMIN_KEY=

# Quote engine. Defaults are PLACEHOLDERS: set real values before charging anyone.
SERVICE_FEE_USD=1.5
SHIPPING_USD_PER_LB=8
US_SALES_TAX_RATE=0.07
DUTY_RATE=0.2
PAYMENT_FEE_RATE=0.02
NGN_PER_USD=1550
FX_BUFFER_RATE=0.03

# Payments (https://paystack.com): required for online payment. Webhook URL: {SITE_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Email (https://resend.com): optional until you want notifications sent
RESEND_API_KEY=
EMAIL_FROM=Shopbrow <hello@yourdomain.com>
ADMIN_EMAIL=

# Public base URL used in emails and payment callbacks
SITE_URL=https://yourdomain.com
